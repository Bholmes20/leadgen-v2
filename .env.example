# Copy this file to .env.local and fill in values.
# Never commit .env.local — it is gitignored.

# ── Discord ──────────────────────────────────────────────────────────────────
# Lead alert channel (required)
DISCORD_WEBHOOK_URL=

# Ad content channels (optional — falls back to DISCORD_WEBHOOK_URL if blank)
DISCORD_WEBHOOK_AD_CONTENT=
DISCORD_WEBHOOK_JUNK_REMOVAL=
DISCORD_WEBHOOK_LANDSCAPING=
DISCORD_WEBHOOK_SEASONAL=

# ── Ad generation ─────────────────────────────────────────────────────────────
# Secret for POST /api/generate-ads — generate with: openssl rand -hex 32
CRON_SECRET=

# In-process scheduler — set true only on long-running servers, NOT on Vercel
AD_GEN_SCHEDULER=false
AD_GEN_INTERVAL_HOURS=8
AD_GEN_PER_TICK=1

# ── Facebook auto-posting ─────────────────────────────────────────────────────
# Numeric Page ID (from Page → About → Page Info)
FB_PAGE_ID=

# Long-lived Page access token — get one via Graph API Explorer:
#   1. tools.developers.facebook.com/tools/explorer
#   2. Select your App → your Page → add pages_manage_posts + pages_read_engagement
#   3. Generate token → extend to long-lived via:
#      GET /oauth/access_token?grant_type=fb_exchange_token&client_id=APP_ID&client_secret=APP_SECRET&fb_exchange_token=SHORT_TOKEN
FB_PAGE_ACCESS_TOKEN=

# Hours to wait after generating before auto-posting (review window)
FB_APPROVE_DELAY_HOURS=2

# Your site URL — appended to every Facebook post
FB_SITE_URL=https://leads.eseeeent.com

# ── Business identity ─────────────────────────────────────────────────────────
# Displayed on the website and embedded in LocalBusiness schema.
# Must match exactly what you enter on Google Business Profile.
BUSINESS_PHONE=706-828-1733

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3002
