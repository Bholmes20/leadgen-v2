# Copy this file to .env.local and fill in values.
# Never commit .env.local — it is gitignored.

# ── Discord ──────────────────────────────────────────────────────────────────
# Lead alert channel (required)
DISCORD_WEBHOOK_URL=

# Ad content channels (optional — falls back to DISCORD_WEBHOOK_URL if blank)
DISCORD_WEBHOOK_AD_CONTENT=
DISCORD_WEBHOOK_JUNK_REMOVAL=
DISCORD_WEBHOOK_LANDSCAPING=
DISCORD_WEBHOOK_SEASONAL=

# ── Ad generation ─────────────────────────────────────────────────────────────
# Secret for POST /api/generate-ads — generate with: openssl rand -hex 32
CRON_SECRET=

# In-process scheduler — set true only on long-running servers, NOT on Vercel
AD_GEN_SCHEDULER=false
AD_GEN_INTERVAL_HOURS=8
AD_GEN_PER_TICK=1

# ── Facebook auto-posting ─────────────────────────────────────────────────────
# Numeric Page ID (from Page → About → Page Info)
FB_PAGE_ID=

# Long-lived Page access token — get one via Graph API Explorer:
#   1. tools.developers.facebook.com/tools/explorer
#   2. Select your App → your Page → add pages_manage_posts + pages_read_engagement
#   3. Generate token → extend to long-lived via:
#      GET /oauth/access_token?grant_type=fb_exchange_token&client_id=APP_ID&client_secret=APP_SECRET&fb_exchange_token=SHORT_TOKEN
FB_PAGE_ACCESS_TOKEN=

# Hours to wait after generating before auto-posting (review window)
FB_APPROVE_DELAY_HOURS=2

# Your site URL — appended to every Facebook post
FB_SITE_URL=https://leads.eseeent.com

# ── Business identity ─────────────────────────────────────────────────────────
# Displayed on the website and embedded in LocalBusiness schema.
# Must match exactly what you enter on Google Business Profile.
BUSINESS_PHONE=706-828-1733

# ── SMS / Twilio ──────────────────────────────────────────────────────────────
# Twilio REST credentials. If any are blank, SMS sending is treated as disabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Where the "new lead" admin alert SMS is sent.
BRANDON_PHONE=
# Google review link used by the review-request SMS (blank disables it).
GOOGLE_REVIEW_LINK=
#
# ── SMS safety (fail closed) ──────────────────────────────────────────────────
# Global kill switch. Sending is allowed ONLY when this is explicitly truthy
# (true / 1 / yes / on). Absent, blank, or malformed => NO SMS is ever sent.
# Leave DISABLED until inbound handling + opt-out are proven safe.
SMS_ENABLED=false
# Maximum outbound SMS attempts (sent + failed) per UTC day, enforced centrally.
# Malformed/blank falls back to a conservative default (100).
SMS_DAILY_CAP=100

# ── Conversion tracking (optional — dormant until set) ────────────────────────
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so you must
# rebuild after changing them. Leave any blank to disable that vendor.
#
# GA4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Google Ads conversion — account ID (format: AW-XXXXXXXXXX) + the lead conversion label
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Meta (Facebook) Pixel ID (numeric)
NEXT_PUBLIC_META_PIXEL_ID=

# ── Growth Engine adapters (P1 — DORMANT until configured) ────────────────────
# The Opportunity/Growth Intelligence layer reads real GSC/GA4/Ads data through
# adapters. Until these are set, each adapter reports "not connected" and returns
# NO data (never fabricated). Wiring the real API clients is deferred to P1B.
#
# Google Search Console (site + a service-account JSON with read access)
GSC_SITE_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=
# GA4 Data API (numeric property id; reuses GOOGLE_SERVICE_ACCOUNT_JSON)
GA4_PROPERTY_ID=
# Google Ads API
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=

# ── Testing ───────────────────────────────────────────────────────────────────
# Point an isolated/test process at a throwaway SQLite DB (defaults to data/leads.db).
# LEADS_DB_PATH=/tmp/phase3-test.db
# The intel test suite (npm test) sets its own temp LEADS_DB_PATH automatically.

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3002
