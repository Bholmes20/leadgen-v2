# Copy this file to .env.local and fill in values.
# Never commit .env.local — it is gitignored.

# ── Discord ──────────────────────────────────────────────────────────────────
# Lead alert channel (required)
DISCORD_WEBHOOK_URL=

# Ad content channels (optional — falls back to DISCORD_WEBHOOK_URL if blank)
DISCORD_WEBHOOK_AD_CONTENT=
DISCORD_WEBHOOK_JUNK_REMOVAL=
DISCORD_WEBHOOK_LANDSCAPING=
DISCORD_WEBHOOK_SEASONAL=

# ── Ad generation ─────────────────────────────────────────────────────────────
# Secret for POST /api/generate-ads — generate with: openssl rand -hex 32
CRON_SECRET=

# In-process scheduler — set true only on long-running servers, NOT on Vercel
AD_GEN_SCHEDULER=false
AD_GEN_INTERVAL_HOURS=8
AD_GEN_PER_TICK=1

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3002
