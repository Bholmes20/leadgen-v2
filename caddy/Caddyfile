# LeadGen V2 — Caddy reverse proxy
#
# TLS: Cloudflare Origin Certificate (Cloudflare SSL mode: Full strict)
#   Cert: /etc/caddy/tls/cf-cert.pem
#   Key:  /etc/caddy/tls/cf-key.pem
#
# Caddy automatically redirects HTTP → HTTPS when tls is configured.
# Do NOT set Cloudflare SSL to "Flexible" — it must be Full or Full strict.
{
	admin off
}

leads.eseeent.com {
	tls /etc/caddy/tls/cf-cert.pem /etc/caddy/tls/cf-key.pem

	# Protect admin dashboard with HTTP Basic Auth
	@admin path /admin /admin/*
	basic_auth @admin {
		admin $2a$14$r7KNMEplH1uwA9Uid6Kn0.nWwVKWuTitqt0yJUIIsm110T3f0aGt2
	}

	# Block cron-only endpoints — cron jobs call :3002 directly
	@cron path /api/generate-ads /api/followup-cron
	respond @cron 403

	reverse_proxy 127.0.0.1:3002 {
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}
}
