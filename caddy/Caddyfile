# LeadGen V2 — Caddy reverse proxy
#
# TLS: Cloudflare Origin Certificate (Cloudflare SSL mode: Full strict)
#   Cert: /etc/caddy/tls/cf-cert.pem
#   Key:  /etc/caddy/tls/cf-key.pem
#
# Caddy automatically redirects HTTP → HTTPS when tls is configured.
# Do NOT set Cloudflare SSL to "Flexible" — it must be Full or Full strict.
{
	admin off
}

leads.eseeent.com {
	tls /etc/caddy/tls/cf-cert.pem /etc/caddy/tls/cf-key.pem

	# Block admin dashboard — never reachable from the public internet
	@admin path /admin /admin/*
	respond @admin 403

	# Block ad generation endpoint — cron jobs call :3002 directly
	@cron path /api/generate-ads
	respond @cron 403

	reverse_proxy 127.0.0.1:3002 {
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}
}
